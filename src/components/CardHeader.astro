---
const { name, bio, avatar, align, deco } = Astro.props;
const baseUrl = import.meta.env.BASE_URL

const avatarSrc = avatar 
  ? `${baseUrl}img/${avatar}`
  : `${baseUrl}img/default.webp`;

let imgClasses = 'rounded-full min-w-18 w-18 h-18 relative';
let headerClasses = 'mb-7 flex gap-4';

if( deco === 'all' || deco === 'avatar' ) {
  imgClasses = imgClasses + ' ring-3 ring-accent';
}

if(align === 'center') {
  headerClasses = headerClasses + ' flex-col items-center';
}
---

<header class={headerClasses}>

    <div class={imgClasses}>
      <img
        src={avatarSrc}
        class="rounded-full"
        alt=""
        width="72"
        height="72"
        loading="eager"
        fetchpriority="high"
      />

      { (deco === 'all' || deco === 'avatar') && <span aria-hidden="true" class="w-4 h-4 border-2 border-bg rounded-full absolute bottom-0 right-0 bg-accent block"></span> }
    </div>

    <div>
      <h1 class="font-semibold text-lg">{ name }</h1>
      {bio && <p class="mt-0.5 text-muted">{bio}</p>}
    </div>
</header>