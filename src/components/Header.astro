---
const { name, bio, avatar, rounded = 'circle' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL

const avatarSrc = avatar 
  ? `${baseUrl}img/${avatar}`
  : `${baseUrl}img/default.webp`;

const radiusMap = {
    circle: 'rounded-full',
    rounded: 'rounded-lg',
    square: 'rounded-none'
};

const imgRadius = radiusMap[rounded] || 'rounded-full';
const imgClasses = `${imgRadius} mx-auto`;
---

<header class="text-center">
    <img
      src={avatarSrc}
      class={imgClasses}
      alt=""
      width="125"
      height="125"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="font-bold">{ name }</h1>
    {bio && <p>{bio}</p>}
</header>