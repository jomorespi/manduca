---
import "../styles/theme.css";

import { getSettings } from '../lib/settings.js';
const settings = getSettings();
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{settings.Content.Name}</title>

    <style define:vars={{ 
        primary: settings.Colors.Primary,
        highlight: settings.Colors.Highlight,
        bg: settings.Colors.Background,
        body: settings.Colors.Body,
        light: settings.Colors.Light 
    }}>
        :root {
            --primary: var(--primary);
            --highlight: var(--highlight);
            --bg: var(--bg);
            --body: var(--body);
            --light: var(--light);
        }
    </style>
</head>
<body class="text-body bg-light">
    <div class="container mx-auto px-5 flex flex-col min-h-screen">
        <slot />
    </div>
</body>
</html>