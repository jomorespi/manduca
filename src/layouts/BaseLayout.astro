---
import "../assets/styles/theme.css";
import { Font } from "astro:assets";

import { getSettings } from '../lib/settings.js';
const settings = getSettings();

const font = settings.Style.Font;

const fontMap = {
    sans: 'font-sans',
    serif: 'font-serif',
    mono: 'font-mono'
};

const fontFamily = fontMap[font] || 'font-sans';

const bodyClasses = `${fontFamily} text-body bg-light`
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{settings.Content.Name}</title>

    <style define:vars={{ 
        primary: settings.Colors.Primary,
        highlight: settings.Colors.Highlight,
        bg: settings.Colors.Background,
        body: settings.Colors.Body,
        light: settings.Colors.Light 
    }}>
        :root {
            --primary: var(--primary);
            --highlight: var(--highlight);
            --bg: var(--bg);
            --body: var(--body);
            --light: var(--light);
        }
    </style>
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-lora" />
    <Font cssVariable="--font-jetbrains" />
</head>
<body class={bodyClasses}>
    <div class="container mx-auto px-5 flex flex-col min-h-screen">
        <slot />
    </div>
</body>
</html>