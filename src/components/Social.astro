---
import 'bootstrap-icons/font/bootstrap-icons.css';

const { social } = Astro.props;

const activeSocial = Object.entries(social).filter(([_, url]) => url && url !== '');

const socialIcons = {
  Linkedin: 'bi-linkedin',
  Mastodon: 'bi-mastodon',
  Bluesky: 'bi-bluesky',
  Threads: 'bi-threads',
  Twitter: 'bi-twitter-x',
  Instagram: 'bi-instagram',
  Snapchat: 'bi-snapchat',
  Facebook: 'bi-facebook',
  Vimeo: 'bi-vimeo',
  YouTube: 'bi-youtube',
  TikTok: 'bi-tiktok',
  Twitch: 'bi-twitch',
  Spotify: 'bi-spotify',
  GitHub: 'bi-github',
  GitLab: 'bi-gitlab',
  StackOverflow: 'bi-stack-overflow',
  Discord: 'bi-discord',
  Behance: 'bi-behance',
  Dribble: 'bi-dribbble',
  Reddit: 'bi-reddit',
  Quora: 'bi-quora',
  Substack: 'bi-substack',
  Medium: 'bi-medium',
  WordPress: 'bi-wordpress',
  WhatsApp: 'bi-whatsapp',
  Telegram: 'bi-telegram',
  Strava: 'bi-strava',
};
---

{activeSocial.length > 0 && (
  <ul class="text-center flex items-center justify-center flex-wrap gap-5 text-xl">
    {activeSocial.map(([platform, url]) => (
      <li>
        <a href={url} aria-label={platform} target="_blank" rel="noopener noreferrer">
          <i class={`${socialIcons[platform] || 'bi-link'}`}></i>
        </a>
      </li>
    ))}
  </ul>
)}